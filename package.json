{
  "name": "board.md",
  "version": "0.0.0",
  "description": "A local web board for the markdown task files already in your repo, with live git branch and pull request state.",
  "keywords": [
    "kanban",
    "board",
    "markdown",
    "frontmatter",
    "tasks",
    "git",
    "github",
    "cli"
  ],
  "license": "MIT",
  "author": "Anojan ST",
  "type": "module",
  "bin": {
    "boardmd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
